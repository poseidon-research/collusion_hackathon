          "type": "string"
        },
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
