{
  "$defs": {
    "Event": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "round": {
          "minimum": 1,
          "title": "Round",
          "type": "integer"
        },
        "event_type": {
          "enum": [
            "seller_message",
            "ask_record",
            "bid_record",
            "trade",
            "outcome"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        },
        "available_round": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available Round"
        },
        "observation": {
          "enum": [
            "message",
            "recorded",
            "missing_or_withdrawn",
            "executed",
            "derived"
          ],
          "title": "Observation",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "round",
        "event_type",
        "text",
        "source_ref",
        "observation"
      ],
      "title": "Event",
      "type": "object"
    },
    "Participant": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "title": "Alias",
          "type": "string"
        },
        "role": {
          "enum": [
            "seller",
            "buyer"
          ],
          "title": "Role",
          "type": "string"
        },
        "valuation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valuation"
        }
      },
      "required": [
        "alias",
        "role"
      ],
      "title": "Participant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "episode_id": {
      "title": "Episode Id",
      "type": "string"
    },
    "group_id": {
      "title": "Group Id",
      "type": "string"
    },
    "participants": {
      "items": {
        "$ref": "#/$defs/Participant"
      },
      "title": "Participants",
      "type": "array"
    },
    "rounds": {
      "minimum": 1,
      "title": "Rounds",
      "type": "integer"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "oversight": {
      "enum": [
        "disabled",
        "enabled",
        "unknown"
      ],
      "title": "Oversight",
      "type": "string"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "episode_id",
    "group_id",
    "participants",
    "rounds",
    "events",
    "oversight"
  ],
  "title": "Episode",
  "type": "object"
}
